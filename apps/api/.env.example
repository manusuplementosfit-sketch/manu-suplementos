# Banco PostgreSQL — recomendado: Neon, criado pela aba Storage da Vercel.
# No deploy, a Vercel injeta estas duas variáveis automaticamente.
# Para desenvolver localmente, copie os valores do painel do Neon/Vercel para cá.
# DATABASE_URL = conexão com pool | DATABASE_URL_UNPOOLED = conexão direta (migrations)
DATABASE_URL="postgresql://usuario:senha@host/manu_suplementos?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/manu_suplementos?sslmode=require"

# Segredo usado para assinar o login do vendedor (troque em produção!)
JWT_SECRET="troque-este-segredo"

# Endereço do site (Next) — liberado no CORS
WEB_URL="http://localhost:3000"

# Endereço público desta API (usado para montar URLs de arquivos locais)
API_URL="http://localhost:3001"
PORT=3001

# Vendedor criado pelo seed (npm run db:seed)
ADMIN_NAME="Manu"
ADMIN_EMAIL="admin@manusuplementos.com"
ADMIN_PASSWORD="troque-esta-senha"

# Vercel Blob: quando definido, imagens e comprovantes vão para o Blob
# em vez da pasta local ./uploads (obrigatório na Vercel)
BLOB_READ_WRITE_TOKEN=""
